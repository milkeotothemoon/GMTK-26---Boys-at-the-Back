[ext_resource type="Script" uid="uid://dq3jclhw1sg8i" path="res://scripts/resources/level_config.gd" id="1_srgob"]

[resource]
script = ExtResource("1_srgob")
level_name = "Full Power"
description = "Engines power the machinery. Put a fan, piston or conveyor next to one and it comes alive. String snaps when something fast hits it — useful if you want a delay."
item_cap = 12
allowed_item_ids = Array[String](["marble", "egg", "plank", "beam", "string", "gong", "balloon", "bell", "chicken", "blender", "engine", "megaphone", "cassette_tape", "fan", "piston"])
star1_threshold_db = 70.0
star2_threshold_db = 105.0
star3_threshold_db = 145.0
